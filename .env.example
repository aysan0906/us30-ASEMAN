# US30 / Dow Jones Dashboard - Render environment
# Provider modes: yahoo | twelvedata | polygon | finnhub | alphavantage
DATA_PROVIDER=yahoo
DATA_API_KEY=

# Default candle symbol. DIA is an ETF proxy; the app scales it x100 for display only and blocks trading signals from it.
# For execution-grade analysis, use a provider that returns real US30 candles and set DATA_SYMBOL=US30 (or broker-specific US30 symbol).
# The code automatically uses DISPLAY_SCALE=1 for recognized US30/DJI index symbols and x100 for DIA.
DATA_SYMBOL=DIA
DISPLAY_SCALE=100

# Fallback to Yahoo/DIA when the selected paid API fails or key is missing.
DATA_FALLBACK=true

# Dashboard defaults
DEFAULT_INTERVAL=1h
DEFAULT_BARS=180
WITH_COALITION=false
CACHE_TTL_SECONDS=120

# Optional: adjust provider-specific endpoint behavior
REQUEST_TIMEOUT=10

# Security: required for admin routes; use a long random secret in Render.
ADMIN_SECRET_KEY=
# Telegram auto-dispatch is off by default. Set to 1 only after reviewing the signal source.
ENABLE_TELEGRAM_AUTOPILOT=0
# Optional secret for authenticated GitHub Actions snapshot pushes.
SNAPSHOT_KEY=
ENABLE_TELEGRAM_INTERACTIVE_BOT=0
