# US30 / Dow Jones Dashboard - Render environment
# Provider modes: yahoo | twelvedata | polygon | finnhub | alphavantage
DATA_PROVIDER=yahoo
DATA_API_KEY=

# Default candle symbol. DIA is used because its history is stable; DISPLAY_SCALE=100 maps DIA to approximate US30/DJ30 points.
# If your paid provider returns the real US30/index price directly, set DISPLAY_SCALE=1.
DATA_SYMBOL=DIA
DISPLAY_SCALE=100

# Fallback to Yahoo/DIA when the selected paid API fails or key is missing.
DATA_FALLBACK=true

# Dashboard defaults
DEFAULT_INTERVAL=1h
DEFAULT_BARS=180
WITH_COALITION=false
CACHE_TTL_SECONDS=120

# Optional: adjust provider-specific endpoint behavior
REQUEST_TIMEOUT=10
