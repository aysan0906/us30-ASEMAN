-    // 1. LIVE CLOCKS & SHAMSI (JALALI) DATE (1000ms loop)
-    function updateLiveClocksAndCountdowns() {
-      const now = new Date();
-
-      // Shamsi Full Date in Tehran Timezone
-      try {
-        const shamsiDateStr = new Intl.DateTimeFormat('fa-IR-u-ca-persian', {
-          timeZone: 'Asia/Tehran',
-          year: 'numeric',
-          month: 'long',
-          day: 'numeric',
-          weekday: 'long'
-        }).format(now);
-        document.getElementById('clockShamsiDate').textContent = shamsiDateStr;
-      } catch (e) {
-        document.getElementById('clockShamsiDate').textContent = 'شنبه، ۲۵ مهر ۱۴۰۵';
-      }
-
-      // Tehran Time (HH:MM:SS)
-      try {
-        const tehranTimeStr = new Intl.DateTimeFormat('en-GB', {
-          timeZone: 'Asia/Tehran',
-          hour: '2-digit',
-          minute: '2-digit',
-          second: '2-digit',
-          hour12: false
-        }).format(now);
-        document.getElementById('clockTehran').textContent = tehranTimeStr;
-      } catch (e) {}
-
-      // New York Time (HH:MM:SS)
-      try {
-        const nyTimeStr = new Intl.DateTimeFormat('en-US', {
-          timeZone: 'America/New_York',
-          hour: '2-digit',
-          minute: '2-digit',
-          second: '2-digit',
-          hour12: false
-        }).format(now);
-        document.getElementById('clockNY').textContent = nyTimeStr;
-      } catch (e) {}
-
-      // Wall Street Opening Bell Countdown (NYSE opens 09:30 NY / 17:00 Tehran)
-      const nowEpoch = Math.floor(now.getTime() / 1000);
-      const bellDiff = (17 * 3600) - ((now.getUTCHours() * 3600 + now.getUTCMinutes() * 60 + now.getUTCSeconds() + 12600) % 86400);
-      const bellSecs = (bellDiff > 0 ? bellDiff : (bellDiff + 86400)) % 86400;
-      const bH = Math.floor(bellSecs / 3600);
-      const bM = Math.floor((bellSecs % 3600) / 60);
-      const bS = bellSecs % 60;
-      document.getElementById('sessionCountdown').textContent =
-        `${String(bH).padStart(2,'0')}:${String(bM).padStart(2,'0')}:${String(bS).padStart(2,'0')}`;
-
-      // Ticking Economic Calendar Countdown
-      const diff = _macroTargetEpoch - nowEpoch;
-      const daysEl = document.getElementById('macroDays');
-      const hoursEl = document.getElementById('macroHours');
-      const minsEl = document.getElementById('macroMins');
-      const secsEl = document.getElementById('macroSecs');
-      const lightEl = document.getElementById('macroShieldStatusLight');
-
-      if (diff <= 0 && diff >= -1800) {
-        // Inside release window (0 to 30 mins)
-        if (daysEl) daysEl.innerText = "00";
-        if (hoursEl) hoursEl.innerText = "00";
-        if (minsEl) minsEl.innerText = "00";
-        if (secsEl) secsEl.innerText = "00";
-        document.getElementById('macroEventNameBadge').innerText = "رویداد US CPI در حال انتشار!";
-        if (lightEl) {
-          lightEl.style.background = "#ff3366";
-          lightEl.style.boxShadow = "0 0 14px #ff3366";
-        }
-      } else {
-        const absDiff = Math.abs(diff);
-        const d = Math.floor(absDiff / 86400);
-        const h = Math.floor((absDiff % 86400) / 3600);
-        const m = Math.floor((absDiff % 3600) / 60);
-        const s = Math.floor(absDiff % 60);
-
-        if (daysEl) daysEl.innerText = String(d).padStart(2, '0');
-        if (hoursEl) hoursEl.innerText = String(h).padStart(2, '0');
-        if (minsEl) minsEl.innerText = String(m).padStart(2, '0');
-        if (secsEl) secsEl.innerText = String(s).padStart(2, '0');
-
-        if (diff > 0 && diff <= 2700) {
-          // Under 45 mins - Red danger
-          if (lightEl) {
-            lightEl.style.background = "#ff3366";
-            lightEl.style.boxShadow = "0 0 12px #ff3366";
-          }
-        } else {
-          if (lightEl) {
-            lightEl.style.background = "#00e676";
-            lightEl.style.boxShadow = "0 0 10px #00e676";
-          }
-        }
-      }
-
-      // Auto-increment the "last refresh" seconds counter
-      _secondsSinceRefresh++;
-      const lastRefEl = document.getElementById('lastRefreshSecs');
-      if (lastRefEl) lastRefEl.textContent = `${_secondsSinceRefresh}s پیش`;
-    }
-
