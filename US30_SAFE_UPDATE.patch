-    function checkLiveAudioTriggers(currentPrice) {
-      if (!_audioAlertsEnabled || !_activeSignalParams || !currentPrice) return;
-      const now = Date.now();
-      const p = Number(currentPrice);
-      const action = _activeSignalParams.action;
-      const entry = Number(_activeSignalParams.entry);
-      const sl = Number(_activeSignalParams.sl);
-      const tp1 = Number(_activeSignalParams.tp1);
-
-      if (!entry || !sl || !tp1 || isNaN(p) || p <= 0) return;
-
-      // 1. Entry Zone Proximity (within 3.5 points)
-      if (Math.abs(p - entry) <= 3.5) {
-        if (now - _lastAlertTimes.entry > ALERT_COOLDOWN_MS) {
-          _lastAlertTimes.entry = now;
-          playChimeSound('entry');
-          const dirFa = action.includes('BUY') ? 'خرید' : 'فروش';
-          speakPersianCallout(`توجه: داوجونز در محدوده ورود ستاپ ${dirFa} قرار گرفت`);
-        }
-      }
-
-      // 2. TP1 Hit Notification
-      const tp1Hit = action.includes('BUY') ? (p >= tp1) : (p <= tp1);
-      if (tp1Hit) {
-        if (now - _lastAlertTimes.tp1 > ALERT_COOLDOWN_MS) {
-          _lastAlertTimes.tp1 = now;
-          playChimeSound('tp1');
-          speakPersianCallout('تارگت اول داوجونز لمس شد، معامله را ریسک‌فری کنید');
-        }
-      }
-
-      // 3. SL Proximity Warning (within 2.5 points)
-      const distToSl = Math.abs(p - sl);
-      const isDangerous = action.includes('BUY') ? (p <= entry && distToSl <= 3.0) : (p >= entry && distToSl <= 3.0);
-      if (isDangerous) {
-        if (now - _lastAlertTimes.sl_warning > ALERT_COOLDOWN_MS) {
-          _lastAlertTimes.sl_warning = now;
-          playChimeSound('sl_warning');
-          speakPersianCallout('هشدار مهم: قیمت در نزدیکی حد ضرر داوجونز است');
-        }
-      }
-    }
