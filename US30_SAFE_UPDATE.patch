+        if not rec: return JSONResponse(status_code=404,content={"ok":False,"error":"JOURNAL_RECORD_NOT_FOUND"})
+        expected=str(rec.get("status","")).upper()
+        if expected not in {"DISPATCH_PENDING","DISPATCH_UNKNOWN"}: return JSONResponse(status_code=409,content={"ok":False,"error":"DISPATCH_NOT_RECONCILABLE"})
+        updates={"status":"OPEN","result":"OPEN · تحویل تلگرام پس از بازبینی دستی تأیید شد","dispatch_updated_at":time.strftime("%Y-%m-%d %H:%M:%S UTC"),"dispatch_confirmation_source":"ADMIN_CONFIRMED_AFTER_TELEGRAM_REVIEW","dispatch_confirmation_note":note,"outcome_tracking":"AWAITING_MANUAL_ACTUAL_FILL_AND_EXIT"}
+        if req.telegram_message_id is not None: updates["telegram_message_id"]=req.telegram_message_id
