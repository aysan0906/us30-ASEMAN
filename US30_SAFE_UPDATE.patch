-    function drawJournalEquityCurve(records) {
-      const canvas = document.getElementById('journalEquityCanvas');
-      if (!canvas) return;
-      const ctx = canvas.getContext ? canvas.getContext('2d') : null;
-      if (!ctx) return;
-      const w = canvas.width;
-      const h = canvas.height;
-      ctx.clearRect(0, 0, w, h);
-
-      // Base initial balance for Trendo account
-      let baseBalance = 10.00;
-      let curve = [baseBalance];
-
-      const chronological = [...(records || [])].reverse();
-      chronological.forEach(r => {
-        const pts = Number(r.pnl_pts || 0);
-        const dollarPnl = pts * 0.10; // 0.01 lot in Trendo = $0.10/pt
-        baseBalance += dollarPnl;
-        curve.push(Math.max(0.1, baseBalance));
-      });
-
-      if (curve.length === 1) {
-        curve = [10.0, 10.0, 10.0];
-      }
-
-      const minVal = Math.min(...curve) * 0.95;
-      const maxVal = Math.max(...curve) * 1.05;
-      const range = Math.max(1.0, maxVal - minVal);
-
-      // Background grid lines
-      ctx.strokeStyle = 'rgba(255, 255, 255, 0.06)';
-      ctx.lineWidth = 1;
-      for (let i = 1; i <= 3; i++) {
-        const y = (h / 4) * i;
-        ctx.beginPath();
-        ctx.moveTo(30, y);
-        ctx.lineTo(w - 20, y);
-        ctx.stroke();
-      }
-
-      const stepX = (w - 70) / (curve.length - 1);
-      const points = curve.map((val, idx) => {
-        const x = 40 + idx * stepX;
-        const y = h - 25 - ((val - minVal) / range) * (h - 50);
-        return { x, y, val };
-      });
-
-      // Area gradient
-      const grad = ctx.createLinearGradient(0, 0, 0, h);
-      grad.addColorStop(0, 'rgba(0, 230, 118, 0.35)');
-      grad.addColorStop(1, 'rgba(0, 230, 118, 0.0)');
-      ctx.fillStyle = grad;
-      ctx.beginPath();
-      ctx.moveTo(points[0].x, h - 20);
-      points.forEach(p => ctx.lineTo(p.x, p.y));
-      ctx.lineTo(points[points.length - 1].x, h - 20);
-      ctx.closePath();
-      ctx.fill();
-
-      // Glowing Line
-      ctx.strokeStyle = '#00e676';
-      ctx.lineWidth = 2.5;
-      ctx.shadowColor = '#00e676';
-      ctx.shadowBlur = 8;
-      ctx.beginPath();
-      points.forEach((p, idx) => {
-        if (idx === 0) ctx.moveTo(p.x, p.y);
-        else ctx.lineTo(p.x, p.y);
-      });
-      ctx.stroke();
-      ctx.shadowBlur = 0;
-
-      // Draw points
-      points.forEach((p, idx) => {
-        ctx.fillStyle = idx === points.length - 1 ? '#ffd700' : '#00e676';
-        ctx.beginPath();
-        ctx.arc(p.x, p.y, idx === points.length - 1 ? 5 : 3.5, 0, Math.PI * 2);
-        ctx.fill();
-
-        if (idx === points.length - 1) {
-          ctx.fillStyle = '#ffd700';
-          ctx.font = 'bold 11px monospace';
-          ctx.fillText('$' + p.val.toFixed(2), p.x - 25, p.y - 10);
-        }
-      });
-
-      const latestBal = curve[curve.length - 1];
-      const curEl = document.getElementById('eqCurrentVal');
-      if (curEl) curEl.textContent = '$' + latestBal.toFixed(2);
-      const growthPct = ((latestBal - 10.0) / 10.0 * 100).toFixed(1);
-      const grEl = document.getElementById('eqGrowthPct');
-      if (grEl) grEl.textContent = (growthPct >= 0 ? '+' : '') + growthPct + '٪';
-    }
