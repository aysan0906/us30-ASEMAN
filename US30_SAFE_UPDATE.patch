+@app.post("/api/journal/resolve", dependencies=[Depends(verify_admin_auth)])
+def journal_resolve(req: JournalOutcomeRequest):
+    if not JOURNAL_DURABILITY_CONFIRMED:
+        return JSONResponse(status_code=503,content={"ok":False,"error":"JOURNAL_DURABILITY_UNCONFIRMED","message":journal_durability_status()["message"]})
+    note=(req.note or "").strip()
+    if len(req.record_id)>160 or len(note)>500: return JSONResponse(status_code=400,content={"ok":False,"error":"INVALID_OUTCOME_INPUT"})
+    if not _telegram_dispatch_lock.acquire(blocking=False): return JSONResponse(status_code=409,content={"ok":False,"error":"JOURNAL_BUSY"})
+    try:
+        entry=float(req.actual_entry_price);exit_price=float(req.exit_price)
+        if not (10000<entry<1000000 and 10000<exit_price<1000000): return JSONResponse(status_code=422,content={"ok":False,"error":"INVALID_PRICES"})
+        rec=None
+        with _journal_file_lock:
+            if DISPATCHED_SIGNALS_FILE.exists():
+                for line in DISPATCHED_SIGNALS_FILE.read_text(encoding="utf-8").splitlines():
+                    try: candidate=json.loads(line)
+                    except Exception: continue
+                    if candidate.get("id")==req.record_id: rec=candidate;break
+        if not rec: return JSONResponse(status_code=404,content={"ok":False,"error":"JOURNAL_RECORD_NOT_FOUND"})
+        if str(rec.get("status","")).upper()!="OPEN": return JSONResponse(status_code=409,content={"ok":False,"error":"RECORD_NOT_OPEN"})
+        direction=str(rec.get("direction","")).upper()
+        if direction in {"BUY","LONG"}: pnl=round(exit_price-entry,1)
+        elif direction in {"SELL","SHORT"}: pnl=round(entry-exit_price,1)
+        else: return JSONResponse(status_code=409,content={"ok":False,"error":"INVALID_DIRECTION"})
+        if pnl==0: return JSONResponse(status_code=422,content={"ok":False,"error":"BREAKEVEN_NOT_CLASSIFIED","message":"خروج سربه‌سر به‌صورت WIN/LOSS طبقه‌بندی نمی‌شود."})
+        status="WIN" if pnl>0 else "LOSS"
+        updates={"status":status,"result":f"{status} · خروج واقعی با تأیید دستی","actual_entry_price":round(entry,2),"exit_price":round(exit_price,2),"pnl_pts":pnl,"outcome_source":"MANUAL_ADMIN_CONFIRMED","outcome_tracking":"MANUAL_ACTUAL_FILL_AND_EXIT","outcome_note":note,"closed_at":time.strftime("%Y-%m-%d %H:%M:%S UTC")}
+        if not update_dispatched_signal(req.record_id,updates,expected_status="OPEN"): return JSONResponse(status_code=503,content={"ok":False,"error":"OUTCOME_WRITE_FAILED"})
+        return {"ok":True,"record_id":req.record_id,"status":status,"pnl_pts":pnl,"message":"خروج واقعی دستی ثبت شد؛ مبلغ دلاری محاسبه نشده است."}
+    except (TypeError,ValueError): return JSONResponse(status_code=422,content={"ok":False,"error":"INVALID_PRICES"})
+    finally: _telegram_dispatch_lock.release()
